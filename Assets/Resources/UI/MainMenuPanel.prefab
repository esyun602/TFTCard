  m_text: "\uADF8\uB54C \uD68C\uC911\uC2DC\uACC4\uC5D0\uC11C \uBE5B\uC774 \uB098\uB354\uB2C8,\n\uC655\uC790\uC5D0\uAC8C
    \uBBF8\uB798\uB97C \uBCF4\uC5EC\uC8FC\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4.\n\n\uB355\uBD84\uC5D0
    \uBB34\uC0AC\uD788 \uB3C4\uB9DD\uCCE4\uC9C0\uB9CC \uD63C\uC790\uAC00 \uB41C \uC655\uC790\uB294,\n\uD68C\uC911\uC2DC\uACC4\uC758
